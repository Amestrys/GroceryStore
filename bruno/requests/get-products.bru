meta {
  name: Get products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/products
  body: none
  auth: none
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a product collection payload", function () {
    const body = res.getBody();
    expect(Array.isArray(body)).to.equal(true);
    expect(body.length).to.be.greaterThan(0);

    const first = body[0];
    expect(first).to.be.an("object");
    expect(first).to.have.property("id");

    const hasProductName =
      typeof first.name === "string" || typeof first.title === "string";
    expect(hasProductName).to.equal(true);
  });
}
